# Fill only on your computer. Never send BOT_TOKEN in a chat.
BOT_TOKEN=
# Leave empty at first; /id returns your ID. Add it and restart for manager access.
MANAGER_IDS=
# cloudflare: temporary HTTPS automatically. external: your permanent HTTPS domain.
HTTPS_MODE=cloudflare
MINI_APP_URL=
PORT=8875
DB_PATH=data/telegram.sqlite3
# Usually detected automatically; set full path only if detection fails.
CLOUDFLARED_PATH=
CATALOG_URL=
SUPPORT_URL=
PAYMENT_HOSTS=
INTEGRATION_SECRET=

# Optional: HTTPS service discovery if local SRV DNS fails. No system DNS changes.
CLOUDFLARE_DOH_EDGE=0

# Supported transport: http2 (TCP) or quic (UDP).
CLOUDFLARE_PROTOCOL=http2

# Optional domain-aware VPN routing (requires CLOUDFLARE_DOH_EDGE=1).
CLOUDFLARE_EDGE_HOSTNAMES=0
