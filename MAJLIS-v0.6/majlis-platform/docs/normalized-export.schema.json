{
  "$defs": {
    "HistoryRecord": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "maxLength": 32,
          "title": "Status",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 500,
          "title": "Note",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "owner_telegram_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9223372036854775807,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Telegram Id"
        },
        "owner_verified": {
          "default": false,
          "title": "Owner Verified",
          "type": "boolean"
        },
        "visible_to_customer": {
          "default": false,
          "title": "Visible To Customer",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "occurred_at"
      ],
      "title": "HistoryRecord",
      "type": "object"
    },
    "ImportRecord": {
      "additionalProperties": false,
      "properties": {
        "source_order_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Order Id",
          "type": "string"
        },
        "telegram_id_verified": {
          "const": true,
          "title": "Telegram Id Verified",
          "type": "boolean"
        },
        "currency": {
          "const": "RUB",
          "title": "Currency",
          "type": "string"
        },
        "order": {
          "$ref": "#/$defs/NewOrder"
        },
        "status": {
          "maxLength": 32,
          "title": "Status",
          "type": "string"
        },
        "source_created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Created At"
        },
        "eta_confirmed": {
          "default": false,
          "title": "Eta Confirmed",
          "type": "boolean"
        },
        "payment_url": {
          "default": "",
          "maxLength": 2000,
          "title": "Payment Url",
          "type": "string"
        },
        "payment_link_verified": {
          "default": false,
          "title": "Payment Link Verified",
          "type": "boolean"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/HistoryRecord"
          },
          "maxItems": 500,
          "title": "History",
          "type": "array"
        }
      },
      "required": [
        "source_order_id",
        "telegram_id_verified",
        "currency",
        "order",
        "status"
      ],
      "title": "ImportRecord",
      "type": "object"
    },
    "NewOrder": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Number",
          "type": "string"
        },
        "customer_id": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "title": "Customer Id",
          "type": "integer"
        },
        "customer_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Customer Name",
          "type": "string"
        },
        "item": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Item",
          "type": "string"
        },
        "amount": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000000,
          "title": "Amount",
          "type": "integer"
        },
        "shipment": {
          "default": "",
          "maxLength": 100,
          "title": "Shipment",
          "type": "string"
        },
        "eta": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eta"
        }
      },
      "required": [
        "number",
        "customer_id",
        "customer_name",
        "item",
        "amount"
      ],
      "title": "NewOrder",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "title": "Source",
      "type": "string"
    },
    "orders": {
      "items": {
        "$ref": "#/$defs/ImportRecord"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Orders",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source",
    "orders"
  ],
  "title": "ImportPackage",
  "type": "object"
}